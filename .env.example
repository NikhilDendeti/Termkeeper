# Copy to .env and fill in. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Pipeline stage 2/3 confidence gates - see openspec specs for the
# behavior these thresholds control. Defaults match the spec.
CLASSIFICATION_MIN_CONFIDENCE=0.60
CLASSIFICATION_MIN_MARGIN=0.10
EXTRACTION_MIN_CONFIDENCE=0.65

# RazorpayX test-mode keys (used from phase 2 onward)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stored but unused - no webhook endpoint exists in this codebase yet.
RAZORPAY_WEBHOOK_SECRET=

# Pipeline stage 4 (razorpay cross-check) tolerance configuration - see
# specs/razorpay-integration/payout-history-crosscheck/spec.md.
CADENCE_MISMATCH_TOLERANCE_RATIO=0.2
AMOUNT_MISMATCH_TOLERANCE_PCT=0.05

# Gates the stage-4 call in pipeline.services.run_pipeline. Set to false to
# disable razorpay_integration without a code rollback.
ENABLE_STAGE_4=True
